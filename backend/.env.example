# Скопируйте файл в .env и поменяйте значения перед публикацией.
# development — локальный запуск, production — проверка обязательных настроек.
APP_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=campus_demo

# Обязательно замените в продакшене: длинная случайная строка.
JWT_SECRET=dev-only-secret-change-me
JWT_TTL_HOURS=12

COOKIE_NAME=campus_session
# 1 — только по HTTPS. На публичном домене включайте.
COOKIE_SECURE=0

# Откуда разрешены запросы в dev-режиме (Vite).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Хосты для проверки Host и Origin. На сервере добавьте публичный домен с портом.
TRUSTED_HOSTS=127.0.0.1:5000,localhost:5000,127.0.0.1:5173,localhost:5173

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
SOCIAL_RATE_LIMIT=30
SOCIAL_RATE_WINDOW=300

# 1 — если Flask стоит за nginx/Caddy с передачей X-Forwarded-*.
TRUST_PROXY=0

# auto: DeepSeek при наличии ключа, иначе публичный Pollinations как резерв.
# deepseek: только DeepSeek (без ключа вернёт 503 с понятным сообщением).
# pollinations: только публичный бесплатный endpoint.
ASSISTANT_PROVIDER=auto

# DeepSeek, OpenAI-совместимый API. Ключ храните только в .env на сервере.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Резервный публичный endpoint Pollinations; API-ключ не требуется.
ASSISTANT_MODEL=openai
