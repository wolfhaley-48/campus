# Скопируйте файл в .env и поменяйте значения перед публикацией.
# development — локальный запуск, production — проверка обязательных настроек.
APP_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=campus_demo

# Обязательно замените в продакшене: длинная случайная строка.
JWT_SECRET=dev-only-secret-change-me
JWT_TTL_HOURS=12

COOKIE_NAME=campus_session
# 1 — только по HTTPS. На публичном домене включайте.
COOKIE_SECURE=0

# Откуда разрешены запросы в dev-режиме (Vite).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300

# 1 — если Flask стоит за nginx/Caddy с передачей X-Forwarded-*.
TRUST_PROXY=0

# Бесплатный публичный endpoint Pollinations; API-ключ не требуется.
ASSISTANT_MODEL=openai
