# Скопируйте в /etc/systemd/system/campus.service.
# Замените /opt/campus на путь к проекту и www-data на пользователя сервера.

[Unit]
Description=campus demo
After=network.target mongod.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/campus/backend
EnvironmentFile=/opt/campus/backend/.env
ExecStart=/opt/campus/backend/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
