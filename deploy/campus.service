[Unit]
Description=Campus demo (Flask + Gunicorn)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=meow
Group=meow
WorkingDirectory=/home/meow/campus/backend
EnvironmentFile=/home/meow/campus/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/meow/campus/.venv/bin/gunicorn --workers 3 --threads 2 --bind 127.0.0.1:5000 --timeout 100 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/home/meow/campus/backend

[Install]
WantedBy=multi-user.target
